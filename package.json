{
  "name": "shanmen-changming",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "^24.0.0",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node --experimental-strip-types tools/check-boundaries/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "validate:locales": "node --experimental-strip-types tools/validate-locales/index.ts",
    "check-content": "npm run validate:locales && npm run validate:content",
    "check": "npm run check:boundaries && npm run check-content && npm test && npm run build",
    "validate:content": "node --experimental-strip-types tools/validate-content/index.ts"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
